{
  "name": "thikra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "test": "node --import tsx --test server/*.test.ts core/*.test.ts web/*.test.ts",
    "typecheck": "tsc --noEmit",
    "bench": "tsx bench/latency.ts",
    "demo": "tsx scripts/demo-seed.ts",
    "openapi": "tsx scripts/openapi.ts",
    "backup": "tsx scripts/backup.ts create",
    "backup:verify": "tsx scripts/backup.ts verify",
    "backup:list": "tsx scripts/backup.ts list",
    "backup:restore": "tsx scripts/backup.ts restore"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@replit/object-storage": "^1.0.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.17",
    "libphonenumber-js": "^1.13.15",
    "node-sqlite3-wasm": "^0.8.61",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "web-push": "^3.6.7",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "engines": {
    "node": ">=20"
  }
}
