# Every file here carries a hash of its own contents in its name, so a changed file is a changed
# url and this one can never go stale. Say so: without it the host sends no Cache-Control at all
# and the browser re-checks a quarter-megabyte of javascript on every single load.
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable"
</IfModule>
