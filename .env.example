# Thekra — every setting the server reads, in one place.
#
# HOW TO USE: copy this file to `.env` (which git ignores) and fill in what you have.
#   cp .env.example .env
# `pnpm start` and `pnpm dev:server` read it automatically. On a hosting platform, set these as
# real environment variables / secrets instead of shipping a file.
#
# EVERY SECTION IS OPTIONAL. Anything left blank simply switches that feature off — the app keeps
# working and falls back to something written for the purpose. Nothing here needs a code change.
# Never commit a filled-in .env, and never paste a real key into a chat or an issue.


# ───────────────────────────────────────────────────────────────────────────────────────────────
# 1. THE MINIMUM FOR PRODUCTION
# ───────────────────────────────────────────────────────────────────────────────────────────────

# Platform administrators, by phone number, comma separated. WITHOUT THIS THERE IS NO ADMIN AT ALL.
THIKRA_ADMIN_PHONES=

# The site's own public address. Needed for Stripe's return links and the webhook.
THIKRA_PUBLIC_URL=

# Set to `production` on a real deployment. This is what stops sign-in codes being shown on screen.
NODE_ENV=

PORT=8787


# ───────────────────────────────────────────────────────────────────────────────────────────────
# 2. SMS — sending the sign-in code.  THE ONE THING THAT BLOCKS REAL FAMILIES.
#    Leave blank and codes are printed to the server log (development only).
#    Pick ONE of the two options below.
# ───────────────────────────────────────────────────────────────────────────────────────────────

# `twilio`, or `http` for any other provider, or blank for the console.
THIKRA_SMS_PROVIDER=

# --- Option A: Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# One of these two: a sender number, or a Messaging Service.
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# --- Option B: any provider with an HTTP API (DreamSoft or another), described here, no code ---
# Placeholders you may use: {to} the number as +9715…, {to_digits} the same without the +,
# {text} the message. Each is escaped for where it lands (JSON inside a JSON body, percent-encoded
# inside a URL or a form), so an Arabic message cannot break the request or add a field.
THIKRA_SMS_URL=
THIKRA_SMS_METHOD=POST
# A JSON object. content-type defaults to application/json.
#   example: {"Authorization":"Bearer YOUR-TOKEN"}
THIKRA_SMS_HEADERS=
# Required for POST. Sent exactly as written, with the placeholders filled in.
#   JSON example: {"to":"{to}","message":"{text}","sender":"Thekra"}
#   form example: to={to_digits}&text={text}   (with content-type application/x-www-form-urlencoded)
THIKRA_SMS_BODY=
# Optional. Text that must appear in the provider's answer, else the send counts as failed.
# Some providers answer 200 with a failure in the body, which would swallow every code silently.
THIKRA_SMS_OK=

# --- Cost and fraud protection (SMS pumping is how an app gets a surprise bill) ---
# Only these country calling codes may receive a code. Blank means every country.
THIKRA_SMS_ALLOWED_CODES=
# A hard ceiling on messages per day, whatever happens. Default 2000.
THIKRA_SMS_DAILY_CAP=


# ───────────────────────────────────────────────────────────────────────────────────────────────
# 3. LANGUAGE MODEL — the yearly story book, and the owner's operations agent.
#    Blank: the book is written by the built-in rules and the agent answers from rules. Both work.
# ───────────────────────────────────────────────────────────────────────────────────────────────

# `anthropic` or `openai`. A provider without its own key below counts as no provider at all.
THIKRA_AI_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ALWAYS SET THIS. Model names are retired faster than this file is edited, so the built-in
# default is only a starting point.
THIKRA_AI_MODEL=

# Optional: any OpenAI-compatible endpoint instead of OpenAI's own (Azure, a gateway, a local server).
THIKRA_AI_BASE_URL=

# Optional: dollars per million tokens, for the budget figure on the owner's screen ONLY.
# Never used for billing. Defaults follow the chosen provider.
THIKRA_AI_USD_IN=
THIKRA_AI_USD_OUT=


# ───────────────────────────────────────────────────────────────────────────────────────────────
# 4. PAYMENTS (Stripe) — blank means the plan buttons answer "payments are not switched on yet".
# ───────────────────────────────────────────────────────────────────────────────────────────────

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The Prices you created in the Stripe dashboard: one Product per plan, one Price per interval.
# A plan left blank still works — it falls back to an inline price from our own plan table — so
# these can be filled in one at a time. The admin payments screen reads each Price back from
# Stripe and says whether it matches our plan table.
STRIPE_PRICE_FAMILY_MONTH=
STRIPE_PRICE_FAMILY_YEAR=
STRIPE_PRICE_HERITAGE_MONTH=
STRIPE_PRICE_HERITAGE_YEAR=


# ───────────────────────────────────────────────────────────────────────────────────────────────
# 5. STORAGE AND BACKUPS
# ───────────────────────────────────────────────────────────────────────────────────────────────

# The SQLite database. BACK THIS UP.
THIKRA_DB=
# Media files. BACK THIS UP.
THIKRA_BLOBS=
# Nightly backups. Put them on a different disk if you can.
THIKRA_BACKUPS=
# `0` turns the nightly backup off.
THIKRA_BACKUP=

# A copy kept off this server, so a lost disk is not lost data.
#   off | replit | dir:/some/path
THIKRA_OFFSITE=
THIKRA_OFFSITE_MINUTES=


# ───────────────────────────────────────────────────────────────────────────────────────────────
# 6. SECURITY AND OPERATIONS
# ───────────────────────────────────────────────────────────────────────────────────────────────

# `1` only when a load balancer or reverse proxy sits in front, so the caller's address is read
# from x-forwarded-for. Setting it without a proxy lets anyone forge their address.
THIKRA_TRUST_PROXY=

# Staff screens demand a PIN in production. `0` turns that off — for local testing only.
THIKRA_ADMIN_REQUIRE_PIN=
# `1` additionally demands an authenticator app for staff.
THIKRA_ADMIN_REQUIRE_TOTP=
# Optional: only these IP addresses may reach the staff screens, comma separated.
THIKRA_ADMIN_IPS=

# A stop-gap until real SMS exists: a fixed code an admin may sign in with, after requesting one.
# DELETE THIS the day SMS works.
THIKRA_OWNER_CODE=

# Who may embed the site in a frame. Default 'none'.
THIKRA_FRAME_ANCESTORS=

# The contact address push services see. Put a real one.
THIKRA_PUSH_SUBJECT=

# `0` turns the structured log off, `1` forces it on. Message contents are never logged.
THIKRA_LOG=

# `wasm` forces the WebAssembly SQLite build (needed on Node older than 22.13).
THIKRA_SQLITE=

# Shows the sign-in code on screen for the five demo numbers only. A PUBLIC DEMO ONLY — never on
# a deployment holding real families.
THIKRA_DEMO_MODE=
